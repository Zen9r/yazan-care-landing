---
import '@fontsource/tajawal/400.css';
import '@fontsource/tajawal/700.css';
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Page Title & Description -->
  <title>عناية يزن | Yazan's Care</title>
  <meta name="description" content="وجهتكم للعناية الشخصية والتجميل، حيث نقدم لكم تجربة مميزة وعناية فائقة.">
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://yazan-care.netlify.app/">
  <meta property="og:title" content="عناية يزن | Yazan's Care">
  <meta property="og:description" content="وجهتكم للعناية الشخصية والتجميل، حيث نقدم لكم تجربة مميزة وعناية فائقة.">
  <meta property="og:image" content="https://yazan-care.netlify.app/og-image.jpg">
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="https://yazan-care.netlify.app/">
  <meta property="twitter:title" content="عناية يزن | Yazan's Care">
  <meta property="twitter:description" content="وجهتكم للعناية الشخصية والتجميل، حيث نقدم لكم تجربة مميزة وعناية فائقة.">
  <meta property="twitter:image" content="https://yazan-care.netlify.app/og-image.jpg">
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/Logo.png">
</head>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #09424c;
  padding: 24px;
  font-family: 'Tajawal', sans-serif;
  position: relative;
}

body::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: url('/pattern.png');
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
  filter: blur(3px);
  z-index: 0;
}

body::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(9, 66, 76, 0.5);
  z-index: 1;
}

    
    main {
      width: 100%;
      max-width: 360px;
      position: relative;
      z-index: 2;
    }
    
    .logo-container {
      text-align: center;
      margin-bottom: 24px;
    }
    
    .logo-container img {
      width: 200px;
      height: 200px;
      object-fit: contain;
      filter: drop-shadow(0 8px 24px rgba(0,0,0,0.4));
    }
    
    .buttons {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    
    .btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 16px 28px;
      border-radius: 14px;
      text-decoration: none;
      font-weight: 700;
      font-size: 17px;
      transition: all 0.25s ease;
      box-shadow: 0 3px 12px rgba(0,0,0,0.15);
      border: none;
    }
    
    .btn:active {
      transform: scale(0.96);
    }
    
    .btn-call {
      background: #c19a6b;
      color: white;
    }
    
    .btn-call:hover {
      background: #d4ab7a;
      box-shadow: 0 5px 18px rgba(193, 154, 107, 0.35);
    }
    
    .btn-whatsapp {
      background: #25D366;
      color: white;
    }
    
    .btn-whatsapp:hover {
      background: #20ba5a;
      box-shadow: 0 5px 18px rgba(37, 211, 102, 0.35);
    }
    
    .btn-location {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(8px);
      color: white;
      border: 1.5px solid rgba(255, 255, 255, 0.3);
    }
    
    .btn-location:hover {
      background: rgba(255, 255, 255, 0.22);
      border-color: rgba(255, 255, 255, 0.45);
    }
    
    .icon {
      width: 22px;
      height: 22px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    
    @media (max-width: 400px) {
      main {
        max-width: 100%;
      }
      
      .logo-container img {
        width: 170px;
        height: 170px;
      }
      
      .btn {
        font-size: 16px;
        padding: 15px 24px;
      }
    }

      /* العبارة الترحيبية - ضيف هنا */
  .welcome-text {
    text-align: center;
    margin-bottom: 32px;
    animation: fadeIn 1s ease-out forwards;
    animation-delay: 0.5s;
    opacity: 0;
  }

  .welcome-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: white;
    margin-bottom: 12px;
    text-shadow: 0 2px 10px rgba(0,0,0,0.3);
  }

  .welcome-subtitle {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    max-width: 360px;
    margin: 0 auto;
    text-shadow: 0 1px 5px rgba(0,0,0,0.2);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 400px) {
    .welcome-title {
      font-size: 1.5rem;
    }
    
    .welcome-subtitle {
      font-size: 0.95rem;
    }
  }
  </style>
  
<body>
  
  <main>
    
    <div class="logo-container">
      <img src="/Logo.png" alt="عناية يزن">
    </div>
     </div>

<!-- العبارة الترحيبية -->
<div class="welcome-text">
  <h2 class="welcome-title">مرحباً بكم في عناية يزن</h2>
  <p class="welcome-subtitle">وجهتكم للعناية الشخصية والتجميل، حيث نقدم لكم تجربة مميزة وعناية فائقة.</p>
</div>

<!-- الأزرار -->
<div class="buttons">

    <div class="buttons">
      
      <a href="tel:+966539977902" class="btn btn-call">
        <svg class="icon" viewBox="0 0 24 24">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>اتصل الآن</span>
      </a>

      <a href="https://wa.me/966539977902" target="_blank" rel="noopener" class="btn btn-whatsapp">
        <svg class="icon" viewBox="0 0 24 24">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
        <span>واتساب</span>
      </a>

      <a href="https://maps.app.goo.gl/qx1Ac45u345rXyvN7?g_st=iw" target="_blank" rel="noopener" class="btn btn-location">
        <svg class="icon" viewBox="0 0 24 24">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <span>موقع المحل</span>
      </a>

    </div>

  </main>

</body>
</html>
